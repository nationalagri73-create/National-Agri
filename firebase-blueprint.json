      },
      "required": ["reviewId", "tenantId", "authorUid", "authorName", "rating", "comment", "createdAt", "updatedAt"]
    },
    "BasitCard": {
      "title": "BasitCard",
      "description": "Employee benefit card with monthly voucher balance, discounts, and validity tracking.",
      "type": "object",
      "properties": {
        "cardId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "holderName": { "type": "string" },
