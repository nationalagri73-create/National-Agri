        "discountSavedEGP": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["redemptionId", "cardId", "ownerUid", "tenantId", "vendorName", "offerTitle", "amountEGP", "discountSavedEGP", "createdAt"]
    },
    "HealthyPlan": {
      "title": "HealthyPlan",
      "description": "Healthy meal subscription plan for individuals, gyms, and sports centers.",
