{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Central governance admin entry granting platform_owner, system_admin, or finance_admin authorization.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminLevel": { "type": "string", "enum": ["platform_owner", "system_admin", "central_super_admin", "finance_admin"] },
        "label": { "type": "string", "minLength": 2, "maxLength": 100 },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "adminLevel", "label", "grantedBy", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII operational user identity and strict 7-role RBAC binding.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": { "type": "string", "enum": ["platform_owner", "system_admin", "factory_manager", "kitchen_manager", "supplier", "employee", "client", "visitor", "customer", "employee_legacy", "entity_admin", "merchant_owner", "merchant_staff", "kitchen_partner", "entertainment_partner", "delivery_client", "courier", "opportunity_partner", "finance_admin", "central_admin", "central_super_admin"] },
        "tenantId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "countryCode": { "type": "string", "enum": ["EG", "AE", "QA", "OM", "GB"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "status", "countryCode", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Strictly isolated user PII document accessible only by owner or system admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "nationalOrTaxId": { "type": "string" },
        "address": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "TenantWorkspace": {
      "title": "TenantWorkspace",
      "description": "White-label factory, central kitchen, supplier, or corporate workspace.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "entityType": { "type": "string", "enum": ["restaurant", "store", "central_kitchen", "company_factory", "delivery_client", "supplier"] },
        "tenantKind": { "type": "string", "enum": ["factory", "central_kitchen", "supplier", "company", "restaurant", "store"] },
        "countryCode": { "type": "string", "enum": ["EG", "AE", "QA", "OM", "GB"] },
        "city": { "type": "string" },
        "commercialRegRef": { "type": "string" },
        "planId": { "type": "string" },
        "customCommissionPct": { "type": "number" },
        "deliveryEnabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "primaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "logoUrl": { "type": "string" },
        "specialtiesAr": { "type": "string" },
        "specialtiesEn": { "type": "string" },
        "capacityMealsPerDay": { "type": "number" },
        "serviceAreasCsv": { "type": "string" },
        "averageRating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "ownerUid", "name", "entityType", "countryCode", "city", "commercialRegRef", "planId", "customCommissionPct", "deliveryEnabled", "status", "createdAt", "updatedAt"]
    },
    "PublicStorefront": {
      "title": "PublicStorefront",
      "description": "Public central kitchen, supplier, and white-label factory storefront directory.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "entityType": { "type": "string" },
        "tenantKind": { "type": "string" },
        "countryCode": { "type": "string" },
        "city": { "type": "string" },
        "primaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "logoUrl": { "type": "string" },
        "specialtiesAr": { "type": "string" },
        "specialtiesEn": { "type": "string" },
        "capacityMealsPerDay": { "type": "number" },
        "serviceAreasCsv": { "type": "string" },
        "averageRating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "name", "entityType", "countryCode", "city", "isActive", "updatedAt"]
    },
    "MarketplaceRfq": {
      "title": "MarketplaceRfq",
      "description": "B2B quote request between client/factory and a central kitchen or supplier.",
      "type": "object",
      "properties": {
        "rfqId": { "type": "string" },
        "requesterUid": { "type": "string" },
        "requesterOrgName": { "type": "string" },
        "phone": { "type": "string" },
        "targetTenantId": { "type": "string" },
        "targetName": { "type": "string" },
        "dailyQty": { "type": "number" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "one_time"] },
        "city": { "type": "string" },
        "details": { "type": "string" },
        "quotedPriceEGP": { "type": "number" },
        "merchantNote": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "quoted", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rfqId", "requesterUid", "requesterOrgName", "phone", "targetTenantId", "targetName", "dailyQty", "frequency", "city", "details", "quotedPriceEGP", "merchantNote", "status", "createdAt", "updatedAt"]
    },
    "MarketplaceReview": {
      "title": "MarketplaceReview",
      "description": "Verified rating & review for central kitchens and suppliers.",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string" },
        "tenantId": { "type": "string" },
