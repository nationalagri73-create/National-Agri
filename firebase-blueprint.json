        "status": { "type": "string", "enum": ["active", "frozen", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cardId", "ownerUid", "holderName", "employeeCode", "tenantId", "factoryName", "cardNumberMasked", "monthlyQuotaEGP", "usedAmountEGP", "validFrom", "validTo", "status", "createdAt", "updatedAt"]
