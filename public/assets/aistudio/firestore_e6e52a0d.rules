      allow list: if isBootstrappedAdmin() || (isSignedIn() && existing().contributorUid == request.auth.uid);
      allow create: if isValidId(contributionId)
        && isSignedIn()
        && isValidCharityContribution(incoming())
        && incoming().contributionId == contributionId
        && incoming().contributorUid == request.auth.uid
        && incoming().status == 'recorded'
        && incoming().proofUrl == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(contributionId)
        && isAdmin()
        && isValidCharityContribution(incoming())
        && incoming().contributionId == existing().contributionId
        && incoming().contributorUid == existing().contributorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (incoming().status != 'executed_verified' || incoming().proofUrl.size() >= 8);
      allow delete: if isValidId(contributionId) && isAdmin();
    }

    match /kaffarah_rules/{ruleId} {
      allow get: if ruleId == 'official';
      allow list: if existing().ruleId == 'official' || isBootstrappedAdmin();
      allow create, update: if ruleId == 'official'
        && isAdmin()
        && isValidKaffarahRule(incoming())
        && incoming().ruleId == 'official'
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /kaffarah_orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        existing().requesterUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isBootstrappedAdmin() || (isSignedIn() && existing().requesterUid == request.auth.uid);
      allow create: if isValidId(orderId)
        && isSignedIn()
        && isValidKaffarahOrder(incoming())
        && incoming().orderId == orderId
        && incoming().requesterUid == request.auth.uid
        && incoming().executionStatus in ['pending_verification', 'awaiting_execution']
        && incoming().executionProofUrl == ''
        && exists(/databases/$(database)/documents/kaffarah_rules/official)
        && get(/databases/$(database)/documents/kaffarah_rules/official).data.isOfficiallyApproved == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidKaffarahOrder(incoming())
        && incoming().orderId == existing().orderId
        && incoming().requesterUid == existing().requesterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (incoming().executionStatus != 'executed_verified' || incoming().executionProofUrl.size() >= 8);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /logistics_service_inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isSignedIn() && (
        existing().requesterUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isBootstrappedAdmin() || (isSignedIn() && existing().requesterUid == request.auth.uid);
      allow create: if isValidId(inquiryId)
        && isSignedIn()
        && isValidLogisticsServiceInquiry(incoming())
        && incoming().inquiryId == inquiryId
        && incoming().requesterUid == request.auth.uid
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(inquiryId)
        && isAdmin()
        && isValidLogisticsServiceInquiry(incoming())
        && incoming().inquiryId == existing().inquiryId
        && incoming().requesterUid == existing().requesterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    match /catering_feedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && isSignedIn() && (
        existing().authorUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isBootstrappedAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);
      allow create: if isValidId(feedbackId)
        && isSignedIn()
        && isValidCateringFeedback(incoming())
        && incoming().feedbackId == feedbackId
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(feedbackId)
        && isAdmin()
        && isValidCateringFeedback(incoming())
        && incoming().feedbackId == existing().feedbackId
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(feedbackId) && isAdmin();
    }

    match /vip_direct_orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        existing().customerUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isBootstrappedAdmin() || (
        isSignedIn() && existing().customerUid == request.auth.uid
      );
      allow create: if isValidId(orderId)
        && isSignedIn()
        && isValidVipDirectOrder(incoming())
        && incoming().orderId == orderId
        && incoming().customerUid == request.auth.uid
        && incoming().status == 'pending_owner'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidVipDirectOrder(incoming())
        && incoming().orderId == existing().orderId
        && incoming().customerUid == existing().customerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Strict App-Owner-Only Financial Dashboard Collections (ONLY hamzaelhelaly08@gmail.com)
    match /owner_financial_accounts/{accountId} {
      allow get, list: if isBootstrappedAdmin();
      allow create, update: if isValidId(accountId)
        && isBootstrappedAdmin()
        && isValidOwnerFinancialAccount(incoming())
        && incoming().accountId == accountId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(accountId) && isBootstrappedAdmin();
    }

    match /owner_financial_entries/{entryId} {
      allow get, list: if isBootstrappedAdmin();
      allow create: if isValidId(entryId)
        && isBootstrappedAdmin()
        && isValidOwnerFinancialEntry(incoming())
        && incoming().entryId == entryId
        && incoming().createdAt == request.time;
      allow update: if isValidId(entryId)
        && isBootstrappedAdmin()
        && isValidOwnerFinancialEntry(incoming())
        && incoming().entryId == existing().entryId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(entryId) && isBootstrappedAdmin();
    }

    match /owner_client_receivables/{receivableId} {
      allow get, list: if isBootstrappedAdmin();
      allow create: if isValidId(receivableId)
        && isBootstrappedAdmin()
        && isValidOwnerClientReceivable(incoming())
        && incoming().receivableId == receivableId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(receivableId)
        && isBootstrappedAdmin()
        && isValidOwnerClientReceivable(incoming())
        && incoming().receivableId == existing().receivableId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(receivableId) && isBootstrappedAdmin();
    }

    match /owner_supplier_payables/{payableId} {
      allow get, list: if isBootstrappedAdmin();
      allow create: if isValidId(payableId)
        && isBootstrappedAdmin()
        && isValidOwnerSupplierPayable(incoming())
        && incoming().payableId == payableId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(payableId)
        && isBootstrappedAdmin()
        && isValidOwnerSupplierPayable(incoming())
        && incoming().payableId == existing().payableId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(payableId) && isBootstrappedAdmin();
    }

    match /owner_financial_audit_logs/{logId} {
      allow get, list: if isBootstrappedAdmin();
      allow create: if isValidId(logId)
        && isBootstrappedAdmin()
        && isValidOwnerFinancialAuditLog(incoming())
        && incoming().logId == logId
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
